{:deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ; logging
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.12"}
        ; system & config
        integrant/integrant {:mvn/version "0.13.1"}
        aero/aero {:mvn/version "1.1.6"}
        metosin/malli {:mvn/version "0.16.4"}
        ; server
        metosin/reitit {:mvn/version "0.7.2"}
        ring/ring-jetty-adapter {:mvn/version "1.13.0"}
        amalloy/ring-gzip-middleware {:mvn/version "0.1.4"}
        hiccup/hiccup {:mvn/version "2.0.0-RC3"}
        ; db
        hikari-cp/hikari-cp {:mvn/version "3.1.0"}
        org.xerial/sqlite-jdbc {:mvn/version "3.47.1.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.955"}
        com.github.seancorfield/honeysql {:mvn/version "2.6.1230"}
        dev.weavejester/ragtime {:mvn/version "0.10.1"}}

 :paths ["src" "resources"]

 :aliases {:dev {:extra-paths ["dev"]
                 :extra-deps {ring/ring-devel {:mvn/version "1.13.0"}
                              integrant/repl {:mvn/version "0.4.0"}}}

           :test {:extra-paths ["test"]
                  :extra-deps {eftest/eftest {:mvn/version "0.6.0"}
                               cloverage/cloverage {:mvn/version "1.2.4"}}
                  :exec-fn cloverage.coverage/run-project
                  :exec-args {:test-ns-path ["test"]
                              :src-ns-path ["src"]
                              :runner :eftest}}

           :outdated {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1250"}}
                      :main-opts ["-m" "antq.core" "--no-diff"]}

           :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.6" :git/sha "52cf7d6"}}
                   :ns-default build}}}
